{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "VITE_API_URL": "https://api.tirbeo.app",
    "NEXT_PUBLIC_API_URL": "https://api.tirbeo.app",
    "VITE_DASHBOARD_URL": "https://dashboard.tirbeo.app"
  },
  "rewrites": [
    {
      "source": "/callback",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
