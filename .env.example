# ─────────────────────────────────────────────────────────────────────────────
# Tirbeo Accounts — environment template
# Copy to .env.local (never commit .env.local) and fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# ─── API ───
VITE_API_URL=https://api.tirbeo.com
NEXT_PUBLIC_API_URL=https://api.tirbeo.com
VITE_DASHBOARD_URL=https://dashboard.tirbeo.com
VITE_APP_DOMAIN=

# ─── Auth / security ───
VITE_GOOGLE_CLIENT_ID=
VITE_BLOCK_REDIRECT_SECRET=
VITE_SENTRY_DSN=

# Supabase (legacy — no longer used by this app)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Pusher Channels (realtime) ─────────────────────────────────────────────
# Server-side credentials — used by apps/api, NEVER prefixed VITE_.
# Five apps: 3× mt1 global pool (sharded) + ap2 (South Asia) + ap4 (APAC).
PUSHER_APP_ID_PRIMARY=
PUSHER_KEY_PRIMARY=
PUSHER_SECRET_PRIMARY=
PUSHER_CLUSTER_PRIMARY=mt1
PUSHER_APP_ID_SECONDARY=
PUSHER_KEY_SECONDARY=
PUSHER_SECRET_SECONDARY=
PUSHER_CLUSTER_SECONDARY=mt1
PUSHER_APP_ID_TERTIARY=
PUSHER_KEY_TERTIARY=
PUSHER_SECRET_TERTIARY=
PUSHER_CLUSTER_TERTIARY=mt1
PUSHER_APP_ID_AP2=
PUSHER_KEY_AP2=
PUSHER_SECRET_AP2=
PUSHER_CLUSTER_AP2=ap2
PUSHER_APP_ID_AP4=
PUSHER_KEY_AP4=
PUSHER_SECRET_AP4=
PUSHER_CLUSTER_AP4=ap4

# Public client config (safe to expose — publishable keys only).
# The client picks ap2/ap4 by timezone; everyone else shards across the mt1 pool.
VITE_PUSHER_KEY_PRIMARY=
VITE_PUSHER_CLUSTER_PRIMARY=mt1
VITE_PUSHER_KEY_SECONDARY=
VITE_PUSHER_CLUSTER_SECONDARY=mt1
VITE_PUSHER_KEY_TERTIARY=
VITE_PUSHER_CLUSTER_TERTIARY=mt1
VITE_PUSHER_KEY_AP2=
VITE_PUSHER_CLUSTER_AP2=ap2
VITE_PUSHER_KEY_AP4=
VITE_PUSHER_CLUSTER_AP4=ap4

# ─── Pusher Beams (web push) ────────────────────────────────────────────────
# Instance ID is public; the primary key is server-side only.
VITE_BEAMS_INSTANCE_ID=
BEAMS_INSTANCE_ID=
BEAMS_PRIMARY_KEY=

# Optional: base URL of the API exposing POST /beams-auth (authenticated-user
# publishing). When unset, the client uses device interests only.
VITE_BEAMS_AUTH_URL=
